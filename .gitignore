# ================================
# Gradle — এগুলো IGNORE করতে হবে
# ================================
.gradle/
**/.gradle/

# ================================
# Build Output — এগুলো IGNORE করতে হবে
# ================================
build/
**/build/
out/
.build-outputs/

# ================================
# Android Studio — এগুলো IGNORE করতে হবে
# ================================
.idea/
*.iml

# ================================
# Local Machine Configuration — IGNORE করতে হবে
# ================================
local.properties

# ================================
# Generated Gradle State/Cache — এগুলো IGNORE করতে হবে
# ================================
**/executionHistory/
**/fileHashes/
**/buildOutputCleanup/
**/configuration-cache/
**/caches/
**/daemon/
**/native/
**/notifications/
**/workers/

# ================================
# Generated Gradle Cache Files — এগুলো IGNORE করতে হবে
# ================================
**/*.work.bin
**/buildfingerprint.bin
**/classloaderscopes.bin
**/projectfingerprint.bin
**/resourceHashesCache.bin
**/fileHashes.bin
**/executionHistory.bin
**/outputFiles.bin
**/candidates.bin
**/gc.properties

